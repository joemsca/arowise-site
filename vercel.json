{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/small-business",
      "destination": "/small-business-menu",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/clients/:client/submit",
      "destination": "/api/codebook-submit?client=:client"
    },
    {
      "source": "/go",
      "destination": "/api/go"
    },
    {
      "source": "/go/:spot",
      "destination": "/api/go?spot=:spot"
    },
    {
      "source": "/demo",
      "destination": "/api/demo"
    },
    {
      "source": "/r/:id",
      "destination": "/api/result?id=:id"
    },
    {
      "source": "/privacy-demo",
      "destination": "/api/privacy"
    },
    {
      "source": "/clients/sapa/class-scheduler/:path*",
      "destination": "https://sapa-class-scheduler.vercel.app/clients/sapa/class-scheduler/:path*"
    },
    {
      "source": "/discovery-questionnaire",
      "destination": "/api/questionnaire?op=page"
    },
    {
      "source": "/discovery-questionnaire/api/:op",
      "destination": "/api/questionnaire?op=:op"
    }
  ]
}
